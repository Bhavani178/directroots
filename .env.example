# DirectRoots — Environment Variables Template
# Copy this file to .env or .env.local and fill in your actual credentials.
# NEVER commit .env or .env.local with real secrets to GitHub.

# ─── Database (Neon PostgreSQL) ──────────────────────────────────────────────
# Get this from your Neon Console (https://console.neon.tech) -> Connection details
DATABASE_URL="postgresql://username:password@ep-your-project-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# ─── NextAuth ────────────────────────────────────────────────────────────────
# Generate a secret: run `openssl rand -base64 32` in terminal
NEXTAUTH_SECRET="your-nextauth-secret-here"

# Set to your deployed domain on Vercel (e.g., https://directroots.vercel.app) or http://localhost:3000 for local dev
NEXTAUTH_URL="http://localhost:3000"

# ─── Cloudinary (Optional Image Uploads) ────────────────────────────────────
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"
